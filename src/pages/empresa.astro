---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Placeholder from '../components/Placeholder.astro';
import { empresa, site, waLink } from '../data/site';
---

<!-- Página Empresa, diseño Manifiesto: frase grande con foto del taller, tres valores y el equipo y un cierre con dos caminos: cotizar o ver la galería.
     Textos y equipo en `empresa` (site.ts). -->
<Layout title={`Empresa · ${site.name}`} description={empresa.intro}>
  <Header />
  <main class="empresa">
    <section class="container hero">
      <div class="copy">
        <p class="eyebrow">Empresa</p>
        <h1 class="section-title">{empresa.title} <em>{empresa.titleEm}</em></h1>
        <p class="lead">{empresa.intro}</p>
      </div>
      <!-- Foto horizontal en su formato original: rostro, herramienta y mano del escultor quedan a la vista -->
      <figure class="photo">
        <img
          src="/galeria/g04.webp"
          srcset="/galeria/g04-sm.webp 700w, /galeria/g04.webp 1463w"
          sizes="(max-width: 900px) 92vw, 50vw"
          alt="Un escultor del taller afina con una herramienta el rostro de un busto de arcilla"
          width="1463"
          height="1000"
        />
      </figure>
    </section>

    <section class="container values" aria-label="Cómo trabajamos">
      {empresa.values.map((v) => (
        <div class="value reveal">
          <h2>{v.title}</h2>
          <p>{v.text}</p>
        </div>
      ))}
    </section>

    <section class="container team-sec" aria-labelledby="equipo-title">
      <p class="eyebrow" id="equipo-title">El equipo</p>
      <ul class="team">
        {empresa.team.map((m) => (
          <li class="member reveal">
            <div class="portrait">
              {m.image ? <img src={m.image} alt={`Retrato de ${m.name}`} loading="lazy" /> : <Placeholder label="Retrato" tone="resina" />}
            </div>
            <h3>{m.name}</h3>
            <p>{m.role}</p>
          </li>
        ))}
      </ul>
      <p class="note">Nombres y cargos de ejemplo</p>
    </section>

    <!-- Cierre: dos caminos, cotizar o ver más trabajo -->
    <section class="container next" aria-label="Siguiente paso">
      <a class="card quote reveal" href={waLink('Hola ENFiBRART, vi su página y quiero cotizar una pieza.')} target="_blank" rel="noopener">
        <span class="kicker">¿Tienes una pieza en mente?</span>
        <span class="big">Cotiza por WhatsApp</span>
        <span class="go">
          Cuéntanos tu idea
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
      <a class="card gallery reveal" href="/galeria">
        <img src="/galeria/g02-sm.webp" alt="" width="700" height="933" loading="lazy" />
        <span class="kicker">Mira nuestro trabajo</span>
        <span class="big">Galería del taller</span>
        <span class="go">
          Fotos y videos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .empresa {
    padding-top: 4.5rem; /* alto del header fijo */
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 5.6vw, 4.8rem);
    margin-top: 1rem;
  }
  .hero .lead {
    margin-top: 1.4rem;
  }
  .photo {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1463 / 1000;
    background: var(--ink-3);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .value {
    padding-top: 1.4rem;
    border-top: 1px solid var(--oro);
  }
  .value h2 {
    font-size: clamp(1.6rem, 2.4vw, 2rem);
  }
  .value p {
    margin-top: 0.6rem;
    color: var(--bone-dim);
    font-size: 0.95rem;
    max-width: 34ch;
  }

  .team-sec {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .team {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.8rem, 2vw, 1.4rem);
  }
  .portrait {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink-3);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member h3 {
    margin-top: 0.8rem;
    font-size: 1.35rem;
    font-weight: 600;
  }
  .member p {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .note {
    margin-top: 1.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }


  .next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.8rem, 2vw, 1.4rem);
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .card {
    position: relative;
    display: grid;
    align-content: end;
    gap: 0.4rem;
    min-height: clamp(220px, 24vw, 300px);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }
  .card .kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card .big {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.8rem);
    line-height: 1.05;
  }
  .card .go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.4rem;
    font-weight: 600;
    font-size: 0.92rem;
    transition: gap 0.2s;
  }
  .card:hover .go {
    gap: 0.8rem;
  }
  .quote {
    background: var(--oro);
    color: var(--ink);
    transition: background-color 0.2s;
  }
  .quote:hover {
    background: var(--oro-hover);
  }
  .gallery {
    color: var(--bone);
    background: var(--ink-3);
  }
  .gallery img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .gallery::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(12, 10, 9, 0.95) 15%, rgba(12, 10, 9, 0.35));
  }
  .gallery:hover img {
    transform: scale(1.04);
  }
  .gallery .kicker,
  .gallery .go {
    color: var(--resina);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .values {
      grid-template-columns: 1fr;
    }
    .team {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .next {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery img,
    .card .go {
      transition: none;
    }
  }
</style>
