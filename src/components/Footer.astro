---
import { site, waLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <p class="wordmark">ENFiBRART</p>
      <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">Empecemos tu proyecto</a>
    </div>
    <div class="bottom">
      <p>© {year} {site.name}. {site.tagline}.</p>
      <ul class="social">
        <li><a href={site.social.instagram}>Instagram</a></li>
        <li><a href={site.social.tiktok}>TikTok</a></li>
        <li><a href={site.social.facebook}>Facebook</a></li>
      </ul>
    </div>
  </div>
</footer>

<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2.1 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.9S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.2-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.9-3.9-1.9-6 0-5.9 4.9-10.7 11-10.7s11 4.8 11 10.7-4.9 10.8-10.9 10.8zm6-8c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z" />
  </svg>
</a>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: clamp(4rem, 8vw, 6rem) 0 2rem;
  }
  .top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .wordmark {
    margin: 0;
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: clamp(1.6rem, 5.4vw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--bone);
  }
  .bottom {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .social {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .social a {
    text-decoration: none;
  }
  .social a:hover {
    color: var(--bone);
  }

  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s;
  }
  .wa-float:hover {
    transform: scale(1.06);
  }
</style>
