---
import { categories, projects } from '../data/site';
import Placeholder from './Placeholder.astro';

const tones = ['warm', 'laca', 'cool', 'resina'] as const;
const labelOf = (id: string) => categories.find((c) => c.id === id)?.label ?? id;
---

<section class="section gallery" id="proyectos">
  <div class="container">
    <div class="head reveal">
      <div>
        <p class="eyebrow">Proyectos</p>
        <h2 class="section-title">Obras que <em>se quedan.</em></h2>
      </div>
      <div class="filters" role="group" aria-label="Filtrar proyectos">
        <button class="chip is-active" data-filter="all" aria-pressed="true">Todos</button>
        {categories.map((c) => (
          <button class="chip" data-filter={c.id} aria-pressed="false">{c.label}</button>
        ))}
      </div>
    </div>

    <ul class="grid">
      {projects.map((p, i) => (
        <li class:list={['card', { tall: p.tall, wide: p.wide }]} data-cat={p.category}>
          <figure>
            <div class="media">
              {p.image ? (
                <img src={p.image} alt={p.title} loading="lazy" />
              ) : (
                <Placeholder label={labelOf(p.category)} tone={tones[i % tones.length]} />
              )}
            </div>
            <figcaption>
              <h3>{p.title}</h3>
              <p>{p.client} · {p.size} · {p.material}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-cat]');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      cards.forEach((card) => {
        card.hidden = f !== 'all' && card.dataset.cat !== f;
      });
    })
  );
</script>

<style>
  .gallery {
    background: var(--ink-2);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--bone-dim);
    cursor: pointer;
    transition: all 0.2s;
  }
  .chip:hover {
    border-color: var(--bone-dim);
    color: var(--bone);
  }
  .chip.is-active {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--ink);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .card.tall {
    grid-row: span 2;
  }
  .card.wide {
    grid-column: span 2;
  }
  .card[hidden] {
    display: none;
  }
  figure {
    margin: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .media {
    position: absolute;
    inset: 0;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figure:hover .media {
    transform: scale(1.04);
  }
  figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 3rem 1.2rem 1.1rem;
    background: linear-gradient(to top, rgba(10, 9, 8, 0.92), transparent);
  }
  figcaption h3 {
    font-size: 1.5rem;
  }
  figcaption p {
    font-size: 0.78rem;
    color: var(--bone-dim);
    margin-top: 0.3rem;
  }
  .card :global(.ph-label) {
    top: 1rem;
    bottom: auto;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 240px;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card.wide {
      grid-column: auto;
    }
    .card.tall {
      grid-row: span 1;
    }
  }
</style>
